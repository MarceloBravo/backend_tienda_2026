# Servidor
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin123
# Solo la usa docker-compose.prod.yml (MySQL en el servidor de producción)
DB_ROOT_PASSWORD=admin123
DB_NAME=tienda2
DB_CONNECTION_LIMIT=5

# CORS (orígenes permitidos del frontend)
FRONTEND_URL=http://localhost:3001
FRONTEND_URL2=http://192.168.1.12:3001

# Seguridad y JWT
SALTROUND=10
TOKEN_SECRETS=hbjbcjhj-my_secret-jgjgjvhc
REFRESHTOKEN_SECRETS=hdkjskd-my_refresh_secret-gysdsu
EXPIRES_TIME_TOKEN=300s
EXPIRES_TIME_REFRESHTOKEN=19800s

# --- Producción (servidor Oracle Free Tier, docker-compose.prod.yml) ---
# El .env del servidor se crea una vez (cp .env.ejemplo .env) y debe cambiar:
#   NODE_ENV=production
#   DB_HOST=db                      # el servicio 'db' del compose, nunca localhost
#   DB_USER=formularios             # no root
#   DB_PASSWORD / DB_ROOT_PASSWORD  # aleatorios: openssl rand -hex 32
#   TOKEN_SECRETS / REFRESHTOKEN_SECRETS  # aleatorios: openssl rand -hex 32
#   FRONTEND_URL=https://tudominio.com    # origen real del frontend
#   FRONTEND_URL2 se elimina
